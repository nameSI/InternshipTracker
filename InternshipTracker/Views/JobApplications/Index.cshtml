@model IEnumerable<InternshipTracker.Models.JobApplication>
@using InternshipTracker.Models

@{
    ViewData["Title"] = "Index";
}

<h1>Job Apllication List</h1>

<p>
    <a class="btn btn-primary" asp-action="Create">Create New</a>
</p>
<form method="get" class="mb-3 d-flex flex-wrap gap-2">
    <input type="text" name="search" class="form-control w-auto"
           placeholder="Search company or role" value="@Context.Request.Query["search"]" />
    <select name="status" class="form-select w-auto" asp
            items="Html.GetEnumSelectList<ApplicationStatus>()">
        <option value="">All statuses</option>
    </select>
    <button class="btn btn-outline-primary">Search</button>
</form>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Company)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Role)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.JobUrl)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Status)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.DateApplied)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Deadline)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Notes)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(model => item.Company)
            </td>
            <td>
                @Html.DisplayFor(model => item.Role)
            </td>
            <td>
                @Html.DisplayFor(model => item.JobUrl)
            </td>
            <td>
                @Html.DisplayFor(model => item.Status)
            </td>
            <td>
                @Html.DisplayFor(model => item.DateApplied)
            </td>
            <td>
                @Html.DisplayFor(model => item.Deadline)
            </td>
            <td>
                @Html.DisplayFor(model => item.Notes)
            </td>
            <td>
                <a class="btn btn-primary" asp-action="Edit" asp-route-id="@item.Id">Edit</a> |
                <a class="btn btn-primary" asp-action="Details" asp-route-id="@item.Id">Details</a> |
                <a class="btn btn-primary" asp-action="Delete" asp-route-id="@item.Id">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
